# =============================================================================
# CacIA — Variáveis de ambiente
# =============================================================================
# Copie para .env e preencha. O .env NUNCA vai para o repositório.
#
# Levantamento: os 4 serviços antigos usavam 72 variáveis, das quais 25 não
# estavam documentadas em nenhum .env.example. Este arquivo cobre todas as que
# permanecem na arquitetura unificada.
#
# Legenda:  [obrigatória]  [opcional]  [tem padrão no código]
# =============================================================================


# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
NODE_ENV=development                      # [padrão: development] development | production
PORT=3000                                 # [padrão: 3000] porta HTTP da API
WEBSITE_URL=http://localhost:3001         # [obrigatória] URL pública do frontend
APP_WEBHOOK_URL=http://localhost:3000     # [obrigatória] URL pública da API — destino dos webhooks


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO
# -----------------------------------------------------------------------------
JWT_SECRET=                               # [obrigatória] segredo de assinatura — gere com: openssl rand -base64 48
JWT_EXPIRATION_TIME=7d                    # [padrão: 7d] validade do token


# -----------------------------------------------------------------------------
# BANCO DE DADOS — PostgreSQL
# -----------------------------------------------------------------------------
# Substitui o MONGODB_URI / DATABASE_URL da arquitetura anterior.
# Porta 5434 no desenvolvimento local — ver docker-compose.yml
DATABASE_URL=postgresql://cacia:cacia@localhost:5434/cacia?schema=public


# -----------------------------------------------------------------------------
# REDIS — filas (Bull) e memória de curto prazo da IA
# -----------------------------------------------------------------------------
REDIS_HOST=localhost                      # [obrigatória]
REDIS_PORT=6380                           # [padrão: 6379; 6380 no compose local]
REDIS_USERNAME=                           # [opcional]
REDIS_PASSWORD=                           # [opcional]
REDIS_DB=0                                # [padrão: 0] banco das filas
REDIS_TLS=false                           # [padrão: false] true em provedores gerenciados
REDIS_PREFIX=cacia:                       # [opcional] prefixo das chaves

# Memória da IA — pode apontar para outra instância. Se vazio, herda os valores acima.
REDIS_MEMORY_HOST=                        # [opcional]
REDIS_MEMORY_PORT=                        # [opcional]
REDIS_MEMORY_USERNAME=                    # [opcional]
REDIS_MEMORY_PASSWORD=                    # [opcional]
REDIS_MEMORY_DB=1                         # [padrão: 1] separado das filas de propósito
REDIS_MEMORY_TLS=                         # [opcional]
REDIS_MEMORY_PREFIX=memory:               # [padrão: memory:]


# -----------------------------------------------------------------------------
# BUSCA VETORIAL — Qdrant
# -----------------------------------------------------------------------------
# Substitui o Pinecone. Filtragem por payload permite busca entre documentos,
# o que o namespace-por-documento do Pinecone impedia.
# Local: `docker compose up -d qdrant`, sem chave.
# Nuvem: crie o cluster em cloud.qdrant.io e troque as duas linhas abaixo — a
# aplicação cria a coleção e os índices sozinha no primeiro boot.
# Ver infra/README.md, "Ao trocar de instância".
QDRANT_URL=http://localhost:6333          # [obrigatória] nuvem: https://<id>.<regiao>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=                           # [obrigatória em produção] vazia em ambiente local
QDRANT_COLLECTION=cacia_vectors           # [padrão: cacia_vectors]


# -----------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL — OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                           # [obrigatória]
OPENAI_MODEL=gpt-4o                       # [padrão: gpt-4o] modelo principal do agente
OPENAI_MAX_TOKENS=4000                    # [padrão: 4000] saída em contexto normal
OPENAI_LARGE_MAX_TOKENS=16384             # [padrão: 16384] saída em contexto grande
OPENAI_TOKEN_THRESHOLD=100000             # [padrão: 100000] acima disso, alterna para o Gemini

# Embeddings — usados pelo RAG e pela memória de longo prazo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # [padrão]
OPENAI_EMBEDDING_DIMENSIONS=1536                # [padrão: 1536] precisa casar com a coleção do Qdrant


# -----------------------------------------------------------------------------
# INTELIGÊNCIA ARTIFICIAL — Google Gemini (contexto grande)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=                           # [obrigatória se usar fallback]
GEMINI_MODEL=gemini-2.5-flash             # [padrão] atualizar conforme a geração vigente
GEMINI_MAX_TOKENS=8192                    # [padrão: 8192]
GEMINI_TOKEN_THRESHOLD=800000             # [padrão: 800000] acima disso, usa o modelo Pro


# -----------------------------------------------------------------------------
# PROCESSAMENTO DE DOCUMENTOS
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000                           # [padrão: 1000] caracteres por trecho
CHUNK_OVERLAP=200                         # [padrão: 200] sobreposição entre trechos
MAX_BASE64_SIZE_BYTES=10485760            # [padrão: 10MB] limite de mídia recebida


# -----------------------------------------------------------------------------
# AGRUPAMENTO DE MENSAGENS
# -----------------------------------------------------------------------------
# Aguarda o contato terminar de digitar antes de acionar a IA — evita responder
# a cada fragmento de uma mesma ideia.
TEXT_BUFFER_ENABLED=true                  # [padrão: true]
TEXT_BUFFER_TIMEOUT_MS=8000               # [padrão: 8000] espera após a última mensagem
TEXT_BUFFER_MAX_MESSAGES=10               # [padrão: 10] dispara ao atingir o limite


# -----------------------------------------------------------------------------
# WHATSAPP — WAHA (provedor principal)
# -----------------------------------------------------------------------------
WAHA_API_URL=                             # [obrigatória] ex.: https://waha.internal:3000
WAHA_API_KEY=                             # [obrigatória]


# -----------------------------------------------------------------------------
# WHATSAPP — Evolution API (fallback)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=                        # [obrigatória] usada quando o WAHA falha
EVOLUTION_API_KEY=                        # [obrigatória]


# -----------------------------------------------------------------------------
# PROXY RESIDENCIAL — Evomi
# -----------------------------------------------------------------------------
# Faz cada sessão WAHA sair por IP residencial, reduzindo risco de bloqueio.
# ATENÇÃO: o código antigo usava 'rp' como padrão e o .env.example dizia 'rpc'.
# Divergência corrigida — o padrão agora é 'rpc' nos dois lugares.
EVOMI_API_KEY=                            # [obrigatória] https://docs.evomi.com/public-api/
EVOMI_PRODUCT=rpc                         # [padrão: rpc] rp = Premium | rpc = Core


# -----------------------------------------------------------------------------
# DADOS PROCESSUAIS — Judit
# -----------------------------------------------------------------------------
JUDIT_API_URL=https://requests.prod.judit.io   # [obrigatória]
JUDIT_API_KEY=                                 # [obrigatória]


# -----------------------------------------------------------------------------
# PAGAMENTOS — IOPay
# -----------------------------------------------------------------------------
IOPAY_API_URL=https://api.iopay.com.br     # [padrão]
IOPAY_EMAIL=                               # [obrigatória]
IOPAY_SECRET=                              # [obrigatória]
IOPAY_SELLER_ID=                           # [obrigatória]


# -----------------------------------------------------------------------------
# ARMAZENAMENTO — DigitalOcean Spaces (compatível com S3)
# -----------------------------------------------------------------------------
DO_ENDPOINT=                               # [obrigatória] ex.: nyc3.digitaloceanspaces.com
DO_BUCKET=                                 # [obrigatória]
DO_KEY=                                    # [obrigatória]
DO_SECRET=                                 # [obrigatória]
DO_PUBLIC_URL=                             # [obrigatória] URL pública dos arquivos
DO_UPLOAD_MAX_FILE_SIZE=20971520           # [padrão: 20MB]


# -----------------------------------------------------------------------------
# VOZ — ElevenLabs
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=                        # [obrigatória se usar áudio]
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1   # [padrão]
ELEVENLABS_VOICE_ID=                       # [obrigatória se usar áudio]
ELEVENLABS_MODEL_ID=eleven_multilingual_v2 # [padrão]
ELEVENLABS_STABILITY=0.5                   # [padrão: 0.5]
ELEVENLABS_SIMILARITY_BOOST=0.75           # [padrão: 0.75]
ELEVENLABS_STYLE=0                         # [padrão: 0]
ELEVENLABS_SPEED=1.0                       # [padrão: 1.0]
ELEVENLABS_USE_SPEAKER_BOOST=true          # [padrão: true]


# -----------------------------------------------------------------------------
# E-MAIL
# -----------------------------------------------------------------------------
ADMIN_EMAIL=                               # [obrigatória] destino de alertas internos


# -----------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS
# -----------------------------------------------------------------------------
CACIA_TOOL_API_KEY=                        # [obrigatória] autentica chamadas de ferramentas externas
N8N_WEBHOOK_URL=                           # [opcional] automações externas


# -----------------------------------------------------------------------------
# OBSERVABILIDADE E PROTEÇÃO
# -----------------------------------------------------------------------------
SENTRY_DSN=                                # [opcional] sem DSN, o Sentry fica inativo
RATE_LIMIT_TTL=60000                       # [padrão: 60s] janela do limite por IP
RATE_LIMIT_MAX=120                         # [padrão: 120] requisições por janela


# =============================================================================
# DESCONTINUADAS — presentes na arquitetura antiga, removidas aqui
# =============================================================================
# MONGODB_URI              → substituída por DATABASE_URL (PostgreSQL)
# PINECONE_API_KEY         → substituída por QDRANT_API_KEY
# PINECONE_INDEX_NAME      → substituída por QDRANT_COLLECTION
# PINECONE_INDEX_HOST      → substituída por QDRANT_URL
# API_MAIN_BASE_URL        → desnecessária: API única, sem chamada entre serviços
# API_MAIN_TOOL_KEY        → idem
# CHAT_AGENT_API_HOST      → memória unificada, sem serviço externo de memória
# CHAT_AGENT_API_TOOL_KEY  → idem
# =============================================================================
