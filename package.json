{
  "name": "cacia",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma CacIA — monorepo",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "test:e2e": "pnpm --filter @cacia/api test:e2e",
    "db:migrate": "node packages/database/node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:studio": "node packages/database/node_modules/prisma/build/index.js studio --schema packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@cacia/config": "workspace:*",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0",
      "vite": "^6.4.3",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.18"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core"
    ]
  }
}
