model Folder {
  id         String  @id @default(uuid()) @db.Uuid
  officeId   String  @map("office_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  title      String
  /// Pasta criada pelo sistema não pode ser removida pelo usuário
  system     Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office   Office    @relation(fields: [officeId], references: [id])
  customer Customer? @relation(fields: [customerId, officeId], references: [id, officeId])

  documents Document[]

  /// Chave candidata para as FKs compostas — amarra o filho ao mesmo tenant
  @@unique([id, officeId])
  @@index([officeId, customerId])
  @@index([officeId, deletedAt])
  @@map("folders")
}

model Document {
  id                String            @id @default(uuid()) @db.Uuid
  officeId          String            @map("office_id") @db.Uuid
  folderId          String?           @map("folder_id") @db.Uuid
  leadId            String?           @map("lead_id") @db.Uuid
  customerId        String?           @map("customer_id") @db.Uuid
  processId         String?           @map("process_id") @db.Uuid
  progressId        String?           @map("progress_id") @db.Uuid
  chatId            String?           @map("chat_id") @db.Uuid
  messageId         String?           @map("message_id") @db.Uuid
  eventId           String?           @map("event_id") @db.Uuid
  type              DocumentType      @default(UPLOAD)
  category          DocumentCategory?
  status            DocumentStatus    @default(DRAFT)
  title             String
  content           String?
  extension         String?
  /// TODO(fase-5): mesmo problema do base64 em Message — migrar para o storage
  contentBase64     String?           @map("content_base64")
  contentUrl        String?           @map("content_url")
  sizeBytes         Int?              @map("size_bytes")
  templateVariables Json?             @map("template_variables") @db.JsonB

  /// Preenchido quando os trechos do documento estão indexados no Qdrant
  vectorStatus       DocumentVectorStatus @default(PENDING) @map("vector_status")
  /// IDs dos pontos no Qdrant — necessários para remover ao excluir o documento
  vectorIds          String[]             @default([]) @map("vector_ids")
  vectorChunksCount  Int                  @default(0) @map("vector_chunks_count")
  vectorTotalTokens  Int?                 @map("vector_total_tokens")
  vectorErrorMessage String?              @map("vector_error_message")
  vectorProcessedAt  DateTime?            @map("vector_processed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office   Office    @relation(fields: [officeId], references: [id])
  folder   Folder?   @relation(fields: [folderId, officeId], references: [id, officeId])
  lead     Lead?     @relation(fields: [leadId, officeId], references: [id, officeId])
  customer Customer? @relation(fields: [customerId, officeId], references: [id, officeId])
  process  Process?  @relation(fields: [processId, officeId], references: [id, officeId])
  progress Progress? @relation(fields: [progressId, officeId], references: [id, officeId])
  chat     Chat?     @relation(fields: [chatId, officeId], references: [id, officeId])
  message  Message?  @relation(fields: [messageId, officeId], references: [id, officeId])
  event    Event?    @relation(fields: [eventId, officeId], references: [id, officeId])

  @@index([officeId, folderId])
  @@index([officeId, customerId])
  @@index([officeId, processId])
  @@index([officeId, status])
  @@index([officeId, deletedAt])
  @@map("documents")
}

