model Calendar {
  id               String  @id @default(uuid()) @db.Uuid
  officeId         String  @map("office_id") @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  title            String
  description      String?
  googleId         String? @map("google_id")
  generalRoles     String? @map("general_roles")
  generalAvailable String? @map("general_available")
  cancelRoles      String? @map("cancel_roles")
  notification     Boolean @default(true)
  status           Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office       @relation(fields: [officeId], references: [id])
  /// Garante que o usuário seja membro deste escritório
  member OfficeMember @relation(fields: [userId, officeId], references: [userId, officeId])
  user   User         @relation(fields: [userId], references: [id])

  availableDays CalendarAvailableDay[]
  events        Event[]

  /// Chave candidata para as FKs compostas — amarra o filho ao mesmo tenant
  @@unique([id, officeId])
  @@index([officeId, status])
  @@index([officeId, userId])
  @@map("calendars")
}

/// Era array embutido no Calendar. Cada dia tem dois turnos configuráveis.
model CalendarAvailableDay {
  id         String  @id @default(uuid()) @db.Uuid
  calendarId String  @map("calendar_id") @db.Uuid
  day        Weekday

  available Boolean @default(false)
  startTime String? @map("start_time")
  endTime   String? @map("end_time")
  online    Boolean @default(false)
  inPerson  Boolean @default(false)

  shift2Available Boolean @default(false) @map("shift2_available")
  shift2StartTime String? @map("shift2_start_time")
  shift2EndTime   String? @map("shift2_end_time")
  shift2Online    Boolean @default(false) @map("shift2_online")
  shift2InPerson  Boolean @default(false) @map("shift2_in_person")

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, day])
  @@map("calendar_available_days")
}

model Event {
  id               String            @id @default(uuid()) @db.Uuid
  officeId         String            @map("office_id") @db.Uuid
  calendarId       String            @map("calendar_id") @db.Uuid
  leadId           String?           @map("lead_id") @db.Uuid
  customerId       String?           @map("customer_id") @db.Uuid
  processId        String?           @map("process_id") @db.Uuid
  progressId       String?           @map("progress_id") @db.Uuid
  type             EventType         @default(HEARING)
  title            String
  description      String?
  startTime        DateTime          @map("start_time")
  endTime          DateTime          @map("end_time")
  status           EventStatus       @default(PENDING)
  consultationMode ConsultationMode? @map("consultation_mode")
  /// Antecedências de lembrete em minutos — era array de objetos com um só campo
  reminderOffsets  Int[]             @default([]) @map("reminder_offsets")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office   Office    @relation(fields: [officeId], references: [id])
  calendar Calendar  @relation(fields: [calendarId, officeId], references: [id, officeId])
  lead     Lead?     @relation(fields: [leadId, officeId], references: [id, officeId])
  customer Customer? @relation(fields: [customerId, officeId], references: [id, officeId])
  process  Process?  @relation(fields: [processId, officeId], references: [id, officeId])
  progress Progress? @relation(fields: [progressId, officeId], references: [id, officeId])

  documents Document[]
  reminders Reminder[]

  /// Chave candidata para as FKs compostas — amarra o filho ao mesmo tenant
  @@unique([id, officeId])
  @@index([officeId, startTime])
  @@index([officeId, status, startTime])
  @@index([officeId, calendarId, startTime])
  @@index([officeId, customerId])
  @@map("events")
}

model Reminder {
  id           String         @id @default(uuid()) @db.Uuid
  officeId     String         @map("office_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  eventId      String?        @map("event_id") @db.Uuid
  leadId       String?        @map("lead_id") @db.Uuid
  customerId   String?        @map("customer_id") @db.Uuid
  processId    String?        @map("process_id") @db.Uuid
  type         ReminderType   @default(CUSTOM)
  title        String
  description  String?
  /// Antecedência em minutos em relação ao evento
  timeTrigger  Int            @map("time_trigger")
  triggerAt    DateTime       @map("trigger_at")
  status       ReminderStatus @default(PENDING)
  sentAt       DateTime?      @map("sent_at")
  errorMessage String?        @map("error_message")
  retryCount   Int            @default(0) @map("retry_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office   Office       @relation(fields: [officeId], references: [id])
  /// Garante que o usuário seja membro deste escritório
  member   OfficeMember @relation(fields: [userId, officeId], references: [userId, officeId])
  user     User         @relation(fields: [userId], references: [id])
  event    Event?       @relation(fields: [eventId, officeId], references: [id, officeId], onDelete: Cascade)
  lead     Lead?        @relation(fields: [leadId, officeId], references: [id, officeId])
  customer Customer?    @relation(fields: [customerId, officeId], references: [id, officeId])
  process  Process?     @relation(fields: [processId, officeId], references: [id, officeId])

  /// Índice do worker: busca lembretes vencidos e ainda pendentes.
  /// Sem officeId de propósito — o worker varre todos os escritórios.
  @@index([status, triggerAt])
  @@index([officeId, triggerAt])
  @@index([eventId])
  @@map("reminders")
}

