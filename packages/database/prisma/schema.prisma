model Question {
  id          String  @id @default(uuid()) @db.Uuid
  officeId    String  @map("office_id") @db.Uuid
  title       String
  description String
  status      Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, status])
  @@map("questions")
}

model Service {
  id          String           @id @default(uuid()) @db.Uuid
  officeId    String           @map("office_id") @db.Uuid
  title       String
  description String
  area        ServiceArea
  valueType   ServiceValueType @map("value_type")
  valueFixed  Decimal?         @map("value_fixed") @db.Decimal(12, 2)
  valueFloat  Decimal?         @map("value_float") @db.Decimal(12, 2)
  valueDetail String?          @map("value_detail")
  status      Boolean          @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, status])
  @@index([officeId, area])
  @@map("services")
}

model Consultation {
  id                        String  @id @default(uuid()) @db.Uuid
  officeId                  String  @unique @map("office_id") @db.Uuid
  isCharged                 Boolean @default(false) @map("is_charged")
  consultationValue         Decimal @default(0) @map("consultation_value") @db.Decimal(12, 2)
  requiresPaymentToSchedule Boolean @default(false) @map("requires_payment_to_schedule")
  lawyerPixKey              String  @default("") @map("lawyer_pix_key")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("consultations")
}

/// Preferências de notificação. Um registro por escritório.
/// n_w_c = notificação WhatsApp para o cliente
/// n_w_a = notificação WhatsApp para o advogado
model Setting {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @unique @map("office_id") @db.Uuid

  notifyClientNewEvent      Boolean @default(true) @map("n_w_c_new_event")
  notifyClientUpdateProcess Boolean @default(true) @map("n_w_c_update_process")

  notifyLawyerNewLead         Boolean @default(true) @map("n_w_a_new_lead")
  notifyLawyerNewCustomer     Boolean @default(true) @map("n_w_a_new_customer")
  notifyLawyerNewMarkLead     Boolean @default(true) @map("n_w_a_new_mark_lead")
  notifyLawyerNewMarkCustomer Boolean @default(true) @map("n_w_a_new_mark_customer")
  notifyLawyerNewDocument     Boolean @default(true) @map("n_w_a_new_document")
  notifyLawyerNewEvent        Boolean @default(true) @map("n_w_a_new_event")
  notifyLawyerUpdateProcess   Boolean @default(true) @map("n_w_a_update_process")
  notifyLawyerUpdateSystem    Boolean @default(true) @map("n_w_a_update_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  officeId   String             @map("office_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  type       NotificationType
  status     NotificationStatus @default(DELIVERY)
  typeId     String             @map("type_id")
  typeTitle  String             @map("type_title")
  typeDetail String             @map("type_detail")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office       @relation(fields: [officeId], references: [id])
  /// Garante que o usuário seja membro deste escritório
  member OfficeMember @relation(fields: [userId, officeId], references: [userId, officeId])
  user   User         @relation(fields: [userId], references: [id])

  @@index([officeId, userId, status])
  @@index([officeId, createdAt])
  @@map("notifications")
}

// =============================================================================
// CONEXÕES DE WHATSAPP
// =============================================================================

model Connection {
  id       String           @id @default(uuid()) @db.Uuid
  officeId String           @map("office_id") @db.Uuid
  type     ConnectionType   @default(WHATSAPP)
  provider WhatsappProvider
  status   ConnectionStatus @default(PENDING)

  /// Quando o provedor é WAHA e o envio falha, cai para a Evolution
  fallbackEnabled Boolean @default(true) @map("fallback_enabled")

  /// Chave da API oficial do WhatsApp — usada quando provider = OFICIAL
  whatsappApiKey String? @map("whatsapp_api_key")

  evolutionApiHost           String?         @map("evolution_api_host")
  evolutionApiInstance       String?         @unique @map("evolution_api_instance")
  evolutionApiKey            String?         @map("evolution_api_key")
  evolutionState             EvolutionState? @map("evolution_state")
  evolutionPhone             String?         @map("evolution_phone")
  evolutionProfileName       String?         @map("evolution_profile_name")
  evolutionProfilePictureUrl String?         @map("evolution_profile_picture_url")
  evolutionProfileStatus     String?         @map("evolution_profile_status")

  wahaApiHost           String?            @map("waha_api_host")
  wahaApiKey            String?            @map("waha_api_key")
  wahaSession           String?            @unique @map("waha_session")
  wahaState             WahaSessionStatus? @map("waha_state")
  wahaPhone             String?            @map("waha_phone")
  wahaProfileName       String?            @map("waha_profile_name")
  wahaProfilePictureUrl String?            @map("waha_profile_picture_url")

  /// Proxy residencial Evomi. proxyScope guarda o nível que de fato funcionou:
  /// a resolução tenta cidade, cai para estado e depois para país.
  proxyCountry   String?     @default("BR") @map("proxy_country")
  proxyState     String?     @map("proxy_state")
  proxyCity      String?     @map("proxy_city")
  proxyScope     ProxyScope? @map("proxy_scope")
  proxyAppliedAt DateTime?   @map("proxy_applied_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  office Office @relation(fields: [officeId], references: [id])

  @@index([officeId, status])
  @@index([wahaSession])
  @@index([evolutionApiInstance])
  @@map("connections")
}
