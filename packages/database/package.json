{
  "name": "@cacia/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma e client de acesso ao PostgreSQL",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "format": "prisma format",
    "validate": "prisma validate",
    "clean": "rimraf dist .turbo generated *.tsbuildinfo",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@cacia/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.17.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
